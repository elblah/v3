#!/usr/bin/env bash
# vision-gateway — bridge aicoder's read_image tool to the dtx vision service.
#
# Usage:
#   vision-gateway <image_path> [query...]
#
# Contract (consumed by aicoder/plugins/vision.py via $VISION_SCRIPT):
#   - Reads one image file (relative paths are resolved from $PWD).
#   - If VISION_MAX_SIZE is set (default 768), downscales the longest side to
#     "<project root>/.vision.jpg", ALWAYS JPEG-encoded (ImageMagick/ffmpeg/
#     GraphicsMagick, best effort), and sends THAT to dtx — the original file
#     is never modified. VISION_MAX_SIZE=0 disables. Images that already fit
#     are sent byte-for-byte unchanged (cheap dims check via `file`; chain
#     skipped). Temp copy removed on exit.
#   - The temp copy MUST live in the project root: this script runs inside
#     the AI sandbox whose /tmp is isolated — dtx (host-side) cannot see it,
#     but cwd is the one shared writable view.
#   - A pre-existing ".vision.jpg" (regular file OR symlink) is never
#     clobbered or followed: the original image is sent unchanged instead.
#   - Prints the vision description text to stdout.
#   - Exit non-zero on any failure (image missing, dtx down, parse error).
#
# Backend: dtx exposes a `vision` command over a unix socket:
#   vision <absolute_image_path> [query]
#
# dtx needs an absolute path; this script resolves whatever you pass
# (relative or absolute) via readlink -f before handing it over. If the
# file is visible it is accepted — dtx reports its own errors otherwise.
#
# Expected dtx response (trimmed):
#   Exit code: 0
#
#   Output:
#   <the vision description>
#
#   Stderr:
#   <...>
#
# Requires: nc with unix-socket support (-U) or socat.

set -u

SOCKET="${DTX_SOCKET:-/run/user/1000/tmp/dtx-server.sock}"

die() {
    echo "vision-gateway: $*" >&2
    exit 1
}

usage() {
    echo "Usage: vision-gateway <image_path> [query...]" >&2
    exit 2
}

[ $# -ge 1 ] || usage

IMG="$1"
shift

[ -f "$IMG" ] || die "image not found: $IMG"

# dtx needs an absolute path; resolve it (relative => from $PWD).
IMG="$(readlink -f "$IMG")" || die "cannot resolve path: $IMG"

# --- Optional downscale to a temp copy (original is never touched) ---
# Same semantics as the vision plugin: VISION_MAX_SIZE default 768,
# 0 = off, unset/invalid = default. External tools only (no python libs):
# ImageMagick (magick -> convert) -> ffmpeg -> GraphicsMagick. Best effort:
# if every tool fails, the original image is sent unchanged.
RESIZE_MAX="${VISION_MAX_SIZE:-768}"
case "$RESIZE_MAX" in
    '' | *[!0-9]*) RESIZE_MAX=768 ;;   # unset/empty/non-numeric -> default
    0) RESIZE_MAX=off ;;
esac

# Early-out: if the image already fits, skip the chain entirely — send the
# original byte-for-byte (no re-encode). Uses `file` (header-only, cheap).
if [ "$RESIZE_MAX" != off ] && command -v file >/dev/null 2>&1; then
    dims="$(file -b "$IMG" 2>/dev/null | sed -nE 's/.*([0-9]+)[[:space:]]*x[[:space:]]*([0-9]+).*/\1 \2/p' | head -n1)"
    if [ -n "$dims" ]; then
        w="${dims% *}"; h="${dims#* }"
        [ "$w" -le "$RESIZE_MAX" ] && [ "$h" -le "$RESIZE_MAX" ] && RESIZE_MAX=off
    fi
fi
RESIZED_TMP=""
trap 'rm -f "$RESIZED_TMP"' EXIT

resize_image() {  # $1=input $2=max $3=output; shrink-only, aspect preserved
    local tool
    if command -v magick >/dev/null 2>&1; then
        magick "$1" -resize "${2}x${2}>" "$3" 2>/dev/null && [ -s "$3" ] && return 0
        rm -f "$3"
    fi
    if command -v convert >/dev/null 2>&1; then
        convert "$1" -resize "${2}x${2}>" "$3" 2>/dev/null && [ -s "$3" ] && return 0
        rm -f "$3"
    fi
    if command -v ffmpeg >/dev/null 2>&1; then
        ffmpeg -y -loglevel error -i "$1" \
            -vf "scale=${2}:${2}:force_original_aspect_ratio=decrease" "$3" 2>/dev/null \
            && [ -s "$3" ] && return 0
        rm -f "$3"
    fi
    if command -v gm >/dev/null 2>&1; then
        gm convert "$1" -resize "${2}x${2}>" "$3" 2>/dev/null && [ -s "$3" ] && return 0
        rm -f "$3"
    fi
    return 1
}

if [ "$RESIZE_MAX" != off ]; then
    # Fixed name, project root (see header). Always JPEG: most compact,
    # universally accepted. Refuse an existing entry — never clobber a real
    # file and never follow a planted symlink pointing outside the project.
    OUT="$PWD/.vision.jpg"
    if [ ! -e "$OUT" ] && [ ! -L "$OUT" ]; then
        if resize_image "$IMG" "$RESIZE_MAX" "$OUT"; then
            RESIZED_TMP="$OUT"          # send the resized jpg copy to dtx
            IMG="$RESIZED_TMP"
        else
            rm -f "$OUT"
        fi
    fi
fi

QUERY="$*"
if [ -n "$QUERY" ]; then
    CMD="vision $IMG $QUERY"
else
    CMD="vision $IMG"
fi

[ -S "$SOCKET" ] || die "dtx socket not found: $SOCKET"

# Non-fatal probe: confirm dtx actually exposes a `vision` command.
if command -v nc >/dev/null 2>&1 && nc -h 2>&1 | grep -q -- '-U'; then
    HELP=$(printf 'help\n' | nc -U "$SOCKET" 2>/dev/null)
    if [ -n "$HELP" ] && ! printf '%s\n' "$HELP" | grep -qi 'vision'; then
        die "dtx does not expose a 'vision' command (seen in help output)"
    fi
fi

# Send the vision command and capture the raw response.
if command -v nc >/dev/null 2>&1 && nc -h 2>&1 | grep -q -- '-U'; then
    RESP=$(printf '%s\n' "$CMD" | nc -U "$SOCKET" 2>/dev/null)
elif command -v socat >/dev/null 2>&1; then
    RESP=$(printf '%s\n' "$CMD" | socat - "UNIX-CONNECT:$SOCKET" 2>/dev/null)
else
    die "need nc (with -U) or socat"
fi

[ -n "$RESP" ] || die "no response from dtx (socket busy or service down)"

# Surface a non-zero dtx exit code as a warning (output is still parsed below).
EXITCODE=$(printf '%s\n' "$RESP" | sed -n 's/^Exit code:[[:space:]]*\([0-9]*\).*/\1/p' | head -n1)
if [ -n "$EXITCODE" ] && [ "$EXITCODE" != "0" ]; then
    echo "vision-gateway: dtx exit code $EXITCODE (see Stderr if empty)" >&2
fi

# Extract the Output section: lines between "Output:" and "Stderr:".
OUT=$(printf '%s\n' "$RESP" | awk '
    /^Output:/  { capture=1; next }
    /^Stderr:/  { capture=0 }
    capture     { print }
')

# Fallback: no "Stderr:" marker — grab everything after the Output: line.
if [ -z "$OUT" ]; then
    OUT=$(printf '%s\n' "$RESP" | awk 'BEGIN{c=0} /^Output:/{c=1;next} c{print}')
fi

# Trim leading/trailing blank lines.
OUT=$(printf '%s\n' "$OUT" | sed -e '1{/^$/d}' -e '${/^$/d}')

if [ -z "$OUT" ]; then
    echo "vision-gateway: could not parse Output from dtx response:" >&2
    echo "$RESP" >&2
    exit 9
fi

printf '%s\n' "$OUT"
